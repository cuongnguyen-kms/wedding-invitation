DATABASE_URL="file:./dev.db"

# Required to access /admin and /api/guests (HTTP Basic Auth, see proxy.ts).
# Without these set, admin routes respond 503 instead of silently staying open.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Only needed if deploying with PostgreSQL instead of SQLite —
# see docs/deployment-postgres.md. Not used by the default dev setup.
POSTGRES_DATABASE_URL=""
